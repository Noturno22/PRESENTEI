{
  "expo": {
    "name": "Presentei",
    "slug": "presentei",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "presentei",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.presentei.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#2D1140"
      },
      "package": "com.presentei.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/icon.png"
    },
    "owner": "samainas-organization",
    "extra": {
      "eas": {
        "projectId": "6f2ec678-48bf-4a68-ab13-3dff82c6619c"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#2D1140"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
